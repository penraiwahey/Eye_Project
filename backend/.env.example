NODE_ENV=development
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=admin_panel
DB_USER=admin_panel
DB_PASSWORD=change_me_password

# Root password used only by docker-compose to initialize MySQL
DB_ROOT_PASSWORD=change_me_root_password

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
COOKIE_NAME=token

# Frontend origin allowed to call this API with credentials
CORS_ORIGIN=http://localhost:5173

# Seed admin account created by `npm run db:init`
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin_password
